# コピーして .env.local を作る: cp .env.example .env.local
# .env.local は絶対にコミットしない。値は PM (@lovemeasure) から受け取るか、自分で発行する。

# Supabase（ローカル: `npm run db:start` の出力にある API URL と service_role key）
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Gemini（https://aistudio.google.com/apikey で発行）
GEMINI_API_KEY=
# モデルを変えたいときだけコメントを外す（省略時は gemini-2.5-flash）
# GEMINI_MODEL=gemini-2.5-flash

# Figma（https://www.figma.com/settings で Personal access token を発行。画像取得スクリプト用）
FIGMA_ACCESS_TOKEN=
