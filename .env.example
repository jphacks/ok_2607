# コピーして .env.local を作る: cp .env.example .env.local
# .env.local は絶対にコミットしない。値は PM (@lovemeasure) から受け取るか、自分で発行する。

# Supabase（ローカル: `npm run db:start` の出力にある API URL と service_role key）
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth 用（クライアント向け公開キー。ローカルは `npx supabase status` の anon key、本番は Project Settings > API の anon public key）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ローカル Supabase で Google 認証を検証する場合（Google Cloud Console で発行した値）
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Gemini（https://aistudio.google.com/apikey で発行）
GEMINI_API_KEY=
# モデルを変えたいときだけコメントを外す（省略時は gemini-2.5-flash）
# GEMINI_MODEL=gemini-2.5-flash

# Figma（https://www.figma.com/settings で Personal access token を発行。画像取得スクリプト用）
FIGMA_ACCESS_TOKEN=
