    "deny": [
      "Bash(supabase db push *)",
      "Bash(npx supabase db push *)",
      "Bash(supabase db push)",
      "Bash(npx supabase db push)",
      "Bash(supabase db reset --linked *)",
      "Bash(npx supabase db reset --linked *)",
      "Bash(supabase link *)",
      "Bash(npx supabase link *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git push origin main)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git add -f *)",
      "Bash(git add --force *)"
    ]
  }
}
